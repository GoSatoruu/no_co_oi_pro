      "attachments": [
        "resolution"
      ],
      "mentorTip": "Phần mệnh giá ghi vào vốn góp (Có 4111), phần chênh lệch giá phát hành cao hơn mệnh giá ghi vào thặng dư vốn (Có 4112)."
    },
    {
      "id": "declare_dividend",
